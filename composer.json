{
    "name": "csgt/utils",
    "description": "CSGT Utils",
    "authors": [
        {
            "name": "Softlogic",
            "email": "software@softlogic.com.gt"
        }
    ],
    "require": {
        "php": ">=7.2"
    },
    "autoload": {
        "classmap": [
            "src/Http/Middleware"
        ],
        "psr-4": {
            "Csgt\\Utils\\": "src"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Csgt\\Utils\\UtilsServiceProvider"
            ]
        }
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Csgt\\Utils\\Tests\\": "tests",
            "App\\": "tests/Fixtures/App/"
        }
    }
}
